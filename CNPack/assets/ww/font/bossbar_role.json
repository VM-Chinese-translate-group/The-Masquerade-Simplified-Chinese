        {
            "type": "bitmap",
            "file": "ww:font/cjk_unifont16.png",
            "ascent": -2006,
            "height": 16,
            "chars": [
                "\u3001\u3002\u4e00\u4e07\u4e09\u4e0a\u4e0b\u4e0d\u4e0e\u4e11\u4e13\u4e14\u4e24\u4e2a\u4e2d\u4e30",
                "\u4e34\u4e3a\u4e3b\u4e3d\u4e45\u4e48\u4e49\u4e4b\u4e4e\u4e50\u4e5f\u4e60\u4e66\u4e71\u4e86\u4e89",
                "\u4e8b\u4e8c\u4e8e\u4e92\u4e9b\u4ea1\u4ea4\u4ea6\u4ea7\u4eab\u4eb2\u4eba\u4ec0\u4ec5\u4ecd\u4ece",
                "\u4ed6\u4ed8\u4ee3\u4ee5\u4eea\u4eec\u4ef6\u4ef7\u4efb\u4efd\u4eff\u4f17\u4f18\u4f19\u4f1a\u4f20",
                "\u4f24\u4f2a\u4f34\u4f3c\u4f46\u4f4d\u4f4f\u4f53\u4f55\u4f59\u4f5c\u4f60\u4f73\u4f7f\u4f8b\u4f8d",
                "\u4f9b\u4f9d\u4fa3\u4fa7\u4fbf\u4fdd\u4fe1\u4fee\u500d\u5012\u5019\u501f\u503c\u5047\u505a\u505c",
                "\u5065\u5076\u50ac\u50cf\u50e7\u5141\u5145\u5148\u5149\u514d\u515a\u5165\u5168\u516c\u5171\u5173",
                "\u5174\u5175\u5176\u5177\u517b\u5185\u518d\u5192\u5199\u519b\u519c\u51b3\u51b5\u51b7\u51c0\u51c6",
                "\u51cf\u51e0\u51e1\u51ed\u51f6\u51fa\u51fb\u5200\u5206\u5207\u5212\u5217\u5219\u521a\u521d\u5224",
                "\u5229\u522b\u5230\u5236\u5237\u523b\u524d\u5267\u5269\u526a\u5272\u529b\u529e\u52a0\u52a1\u52a8",
                "\u52a9\u52bf\u52e4\u5305\u5316\u5320\u533f\u5343\u5347\u534a\u534e\u534f\u5355\u5356\u535a\u535c",
                "\u5360\u5361\u5371\u5373\u5374\u5385\u539f\u53bb\u53c2\u53c8\u53ca\u53cb\u53cc\u53cd\u53d1\u53d6",
                "\u53d7\u53d8\u53db\u53e3\u53e5\u53e6\u53ea\u53eb\u53ec\u53ef\u53f0\u53f3\u53f7\u5404\u5408\u540c",
                "\u540d\u540e\u5411\u5413\u5417\u541e\u5420\u5426\u5427\u542c\u542f\u5431\u5438\u5446\u544a\u5458",
                "\u5468\u5471\u5473\u547c\u547d\u548c\u5492\u5495\u54ac\u54cd\u54e6\u54e7\u54ea\u54f2\u54fc\u5524",
                "\u552f\u5546\u554a\u5584\u559c\u55b5\u55e1\u55e8\u55ef\u561f\u5634\u5657\u565c\u5668\u566c\u56db",
                "\u56de\u56e0\u56e2\u56f0\u56f4\u56fe\u5706\u5708\u5723\u5728\u5730\u573a\u5747\u578b\u57ce\u57fa",
                "\u5806\u585e\u5893\u5899\u589e\u58c1\u58eb\u58ec\u58f0\u58f3\u5904\u5907\u590d\u5916\u591a\u591c",
                "\u591f\u5927\u5929\u592a\u592b\u5931\u5934\u593a\u594f\u5954\u5957\u5965\u597d\u5982\u59a8\u59cb",
                "\u59d3\u5a01\u5a1c\u5a92\u5b50\u5b57\u5b58\u5b59\u5b66\u5b83\u5b85\u5b88\u5b89\u5b8c\u5b98\u5b9a",
                "\u5b9d\u5b9e\u5ba1\u5ba2\u5ba4\u5bb3\u5bb4\u5bb6\u5bb9\u5bbf\u5bc4\u5bc6\u5bcc\u5bdf\u5bf9\u5bfb",
                "\u5bfc\u5c01\u5c04\u5c06\u5c0f\u5c11\u5c14\u5c16\u5c1d\u5c24\u5c31\u5c38\u5c3d\u5c40\u5c45\u5c4f",
                "\u5c55\u5c5e\u5de5\u5de6\u5de8\u5deb\u5dee\u5df1\u5df2\u5df4\u5e03\u5e08\u5e0c\u5e26\u5e2d\u5e2e",
                "\u5e38\u5e55\u5e72\u5e73\u5e76\u5e7d\u5e7f\u5e8f\u5e94\u5e95\u5ea6\u5ea7\u5ed3\u5ef6\u5efa\u5f00",
                "\u5f04\u5f0f\u5f15\u5f20\u5f31\u5f39\u5f3a\u5f53\u5f55\u5f62\u5f71\u5f7c\u5f80\u5f85\u5f88\u5f8b",
                "\u5f92\u5f97\u5faa\u5fae\u5fc3\u5fc5\u5fd7\u5fd8\u5feb\u5ffd\u6000\u6001\u600e\u6012\u601d\u6025",
                "\u6027\u6028\u602a\u603b\u6050\u6062\u606f\u6076\u60a6\u60c5\u60ca\u60d1\u60d5\u60dc\u60e7\u60f3",
                "\u60f9\u610f\u611f\u613f\u614e\u6162\u61c2\u6208\u620f\u6210\u6211\u6216\u6218\u6234\u623f\u6240",
                "\u624b\u624d\u624e\u6253\u6258\u625b\u6269\u626e\u6270\u627e\u627f\u6280\u628a\u6295\u629b\u62a4",
                "\u62b9\u62bd\u62c5\u62d6\u62e5\u62e9\u62ec\u62ff\u6301\u6307\u6309\u6311\u6324\u6325\u6362\u636e",
                "\u6377\u6388\u6389\u638c\u63a2\u63a5\u63a7\u63a8\u63aa\u63d0\u63e1\u63ed\u641e\u6454\u6478\u6491",
                "\u6492\u649e\u64ad\u64cd\u6500\u652f\u6536\u6539\u653e\u653f\u6545\u6548\u6551\u6559\u6563\u6570",
                "\u6572\u6574\u6587\u65ad\u65b0\u65b9\u65bd\u65c1\u65cb\u65e0\u65e2\u65e5\u65e6\u65e9\u65f6\u660e",
                "\u6613\u6620\u662f\u663e\u665a\u666e\u6682\u6697\u66b4\u66f2\u66f4\u66fe\u66ff\u6700\u6708\u6709",
                "\u670b\u670d\u671b\u671d\u671f\u6728\u672a\u672b\u672c\u672f\u673a\u6740\u6742\u675f\u6761\u6765",
                "\u677e\u677f\u6781\u679a\u679c\u67c4\u67d0\u67d3\u67e5\u6807\u680f\u6837\u6838\u6839\u683c\u6848",
                "\u6863\u68c0\u68d8\u690d\u695a\u697c\u6982\u69cc\u69fd\u6a21\u6b21\u6b22\u6b3a\u6b3e\u6b49\u6b4c",
                "\u6b62\u6b63\u6b64\u6b65\u6b7b\u6b8a\u6b8b\u6b93\u6bb5\u6bc1\u6bcd\u6bcf\u6bd2\u6bd4\u6bd5\u6bdb",
                "\u6c11\u6c14\u6c38\u6c42\u6ca1\u6cb3\u6cc4\u6cd5\u6ce8\u6d3b\u6d41\u6d46\u6d4b\u6d6a\u6d88\u6db2",
                "\u6dc6\u6df7\u6e05\u6e14\u6e17\u6e38\u6e90\u6ee1\u6f0f\u6f14\u6f5c\u6f6e\u6f88\u706d\u706f\u7075",
                "\u7089\u70b8\u70b9\u70bc\u70c8\u70e6\u7136\u7167\u71c3\u7206\u722a\u722c\u7231\u7235\u7236\u7247",
                "\u7259\u7267\u7269\u7279\u72af\u72b6\u72c2\u72d0\u72d7\u72ec\u72ee\u72f8\u72fc\u730e\u731b\u731c",
                "\u732a\u732b\u732e\u7387\u738b\u73a9\u73b0\u7403\u7406\u7434\u74dc\u751a\u751f\u7528\u7529\u7531",
                "\u7535\u7537\u753b\u754c\u7559\u7565\u7591\u75ab\u75af\u75d2\u75f9\u767b\u767d\u767e\u7684\u76ae",
                "\u76d7\u76db\u76ee\u76f2\u76f4\u76f8\u770b\u771f\u7720\u773c\u7740\u775b\u7784\u77ad\u77e5\u77ed",
                "\u77f3\u7801\u7834\u7838\u7840\u786e\u793a\u793e\u7956\u795d\u795e\u7968\u796d\u7981\u79bb\u79c0",
                "\u79c1\u79cd\u79d1\u79d2\u79d8\u79f0\u79fb\u7a0b\u7a20\u7a76\u7a7a\u7a7f\u7a81\u7a83\u7acb\u7ad9",
                "\u7adf\u7ae0\u7b11\u7b14\u7b26\u7b2c\u7b49\u7b51\u7b54\u7b56\u7b7e\u7b80\u7b97\u7ba1\u7be1\u8d26",
                "\u7c4d\u7c7b\u7c92\u7c9f\u7cd5\u7cd6\u7cdf\u7cfb\u7d22\u7d2f\u7e41\u7ea0\u7ea2\u7ea7\u7eb3\u7eb5",
                "\u7eb8\u7ebf\u7ec4\u7ec8\u7ecf\u7ed3\u7ed5\u7ed9\u7edd\u7edf\u7ee7\u7eed\u7ef4\u7efd\u7f13\u7f16",
                "\u7f20\u7f29\u7f3a\u7f42\u7f57\u7f6a\u7f6e\u7f8a\u7f8e\u7fbd\u7fc5\u7ffb\u7ffc\u8001\u8003\u8005",
                "\u800c\u800d\u8033\u804a\u8096\u80a4\u80c1\u80c6\u80cc\u80dc\u80f6\u80fd\u8106\u8109\u8111\u817a",
                "\u817f\u8180\u81c2\u81e3\u81ea\u81f3\u81f4\u821e\u822a\u822c\u826f\u8272\u827a\u8282\u82b1\u82cd",
                "\u8303\u8336\u8349\u8350\u836f\u83b7\u8425\u843d\u0000\u8499\u853d\u85cf\u8651\u865a\u866b\u868a",
                "\u86c7\u86d9\u8702\u871c\u8782\u878d\u87b3\u8840\u884c\u8861\u8865\u8868\u88ab\u88ad\u88c5\u8981",
                "\u89c1\u89c2\u89c4\u89c6\u89c8\u89c9\u89d2\u89e3\u89e6\u8a00\u8b66\u8ba1\u8ba4\u8ba9\u8bae\u8bb0",
                "\u8bb8\u8bba\u8bbe\u8bc1\u8bc5\u8bc6\u8bc8\u8bc9\u8bcd\u8bd5\u8bdd\u8be1\u8be5\u8be6\u8bed\u8bef",
                "\u8bf4\u8bf7\u8bfb\u8c01\u8c03\u8c08\u8c0d\u8c0e\u8c15\u8c1c\u8c23\u8c28\u8c5a\u8c61\u8c8c\u8d1f",
                "\u8d23\u8d24\u8d25\u8d39\u8d3c\u8d44\u8d4c\u8d4f\u8d6b\u8d70\u8d77\u8d8a\u8db3\u8dd1\u8ddd\u8ddf",
                "\u8def\u8df3\u8e2a\u8eab\u8eb2\u8f6c\u8f6e\u8f7b\u8f7d\u8f83\u8f88\u8f91\u8f93\u8f9e\u8fa8\u8fb9",
                "\u8fc5\u8fc7\u8fce\u8fd0\u8fd1\u8fd4\u8fd8\u8fd9\u8fdb\u8fdc\u8fde\u8fe6\u8ff0\u8ff7\u8ffd\u9001",
                "\u9002\u9006\u9009\u900f\u9010\u9014\u901a\u901f\u9020\u903b\u9047\u9053\u906d\u907f\u9080\u90a3",
                "\u90aa\u90ae\u90b8\u90bb\u90e8\u90fd\u914d\u9177\u91ca\u91cc\u91cd\u91cf\u91d1\u9488\u9493\u949f",
                "\u94a2\u9501\u9519\u952e\u9547\u9556\u957f\u95e8\u95ea\u95ed\u95ee\u95f4\u95fb\u9601\u9605\u961f",
                "\u9632\u9635\u963b\u9644\u9645\u9648\u964c\u964d\u9650\u9662\u9664\u9669\u9677\u968f\u9690\u9694",
                "\u96be\u96c6\u96d5\u96e8\u9700\u9707\u9709\u9732\u9752\u9759\u975e\u9760\u9762\u97f3\u9875\u9876",
                "\u9879\u987a\u987b\u9884\u9891\u9898\u989d\u98ce\u98de\u98df\u9970\u9986\u9996\u9a6c\u9a71\u9a76",
                "\u9a7e\u9a8c\u9a91\u9a97\u9ab7\u9ac5\u9ad8\u9b3c\u9b42\u9b45\u9b54\u9c7c\u9ca8\u9cb1\u9e1f\u9e23",
                "\u9e3d\u9e45\u9e49\u9e66\u9e70\u9ebb\u9ecf\u9f13\u9f20\u9f3b\uff01\uff08\uff09\uff0c\uff1a\uff1b",
                "\uff1f\u68a6\u9b47\u82ae\u5179\u707e\u5384\u8baf\u62db\u62df\u8d29\u0000\u0000\u0000\u0000\u0000"
            ]
        },
